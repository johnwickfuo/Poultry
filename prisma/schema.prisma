generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SUPPRESSED
}

enum SellerVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SubOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
  REFUNDED
  SETTLED
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  username               String                   @unique
  passwordHash           String?
  emailVerifiedAt        DateTime?
  emailHardBouncedAt     DateTime?
  emailSuppressedAt      DateTime?
  emailSuppressionReason String?                  @db.VarChar(500)
  status                 UserStatus               @default(PENDING)
  sessionVersion         Int                      @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?
  profile                Profile?
  roles                  UserRole[]
  accounts               Account[]
  sessions               Session[]
  verificationTokens     EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  emailDeliveries        EmailDelivery[]
  sellerProfile          SellerProfile?           @relation("SellerOwner")
  approvedSellerProfiles SellerProfile[]          @relation("SellerApprovals")
  products               Product[]                @relation("SellerProducts")
  moderatedProducts      Product[]                @relation("ProductModerator")
  cart                   Cart?
  orders                 Order[]                  @relation("BuyerOrders")
  sellerSubOrders        SubOrder[]               @relation("SellerSubOrders")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String?
  fullName    String?
  phone       String?
  whatsapp    String?
  avatarPath  String?
  state       String?
  lga         String?
  bio         String? @db.Text
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  businessName       String?
  businessType       String?
  description        String?                  @db.Text
  phone              String?
  whatsapp           String?
  email              String?
  state              String?
  lga                String?
  address            String?
  logoPath           String?
  verificationStatus SellerVerificationStatus @default(DRAFT)
  rejectionReason    String?                  @db.Text
  approvedAt         DateTime?
  approvedByUserId   String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation("SellerOwner", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy         User?                    @relation("SellerApprovals", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([verificationStatus, createdAt])
  @@index([approvedByUserId])
}

model Category {
  id          String     @id @default(cuid())
  parentId    String?
  name        String
  slug        String     @unique
  description String?    @db.Text
  imagePath   String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, isActive, sortOrder])
}

model Product {
  id                   String           @id @default(cuid())
  sellerId             String
  categoryId           String
  name                 String
  slug                 String
  shortDescription     String?
  description          String           @db.Text
  brand                String?
  species              String?
  condition            String?
  sku                  String?
  basePriceKobo        Int
  stockQuantity        Int              @default(0)
  minimumOrderQuantity Int              @default(1)
  unitLabel            String           @default("item")
  status               ProductStatus    @default(DRAFT)
  isFeatured           Boolean          @default(false)
  isPublished          Boolean          @default(false)
  manufacturer         String?
  activeIngredient     String?
  dosageForm           String?
  packSize             String?
  expiryDate           DateTime?
  rejectionReason      String?          @db.Text
  moderatedAt          DateTime?
  moderatedByUserId    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  seller               User             @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  category             Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  moderatedBy          User?            @relation("ProductModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  variants             ProductVariant[]
  images               ProductImage[]
  bulkPriceTiers       BulkPriceTier[]
  cartItems            CartItem[]
  orderItems           OrderItem[]

  @@unique([slug])
  @@unique([sellerId, sku])
  @@index([categoryId, status, isPublished])
  @@index([sellerId, status, updatedAt])
  @@index([moderatedByUserId])
  @@fulltext([name, shortDescription, description, brand, species], map: "Product_marketplace_search_idx")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  name          String
  options       Json
  sku           String?
  priceKobo     Int
  stockQuantity Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([productId, sku])
  @@index([productId, isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  path      String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model BulkPriceTier {
  id              String   @id @default(cuid())
  productId       String
  minimumQuantity Int
  maximumQuantity Int?
  unitPriceKobo   Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minimumQuantity])
  @@index([productId, minimumQuantity])
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?    @unique
  guestTokenHash String?    @unique @db.VarChar(64)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id                    String          @id @default(cuid())
  cartId                String
  productId             String
  variantId             String?
  variantKey            String          @default("")
  quantity              Int
  unitPriceSnapshotKobo Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  cart                  Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product               Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant               ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  reference         String      @unique @db.VarChar(32)
  subtotalKobo      BigInt
  deliveryTotalKobo BigInt
  grandTotalKobo    BigInt
  currency          String      @default("NGN") @db.Char(3)
  status            OrderStatus @default(PENDING_PAYMENT)
  paymentGateway    String      @db.VarChar(32)
  gatewayReference  String?     @unique @db.VarChar(191)
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation("BuyerOrders", fields: [userId], references: [id], onDelete: Restrict)
  subOrders         SubOrder[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SubOrder {
  id                        String         @id @default(cuid())
  orderId                   String
  sellerId                  String
  subtotalKobo              BigInt
  commissionPercentSnapshot Decimal        @db.Decimal(5, 2)
  commissionAmountKobo      BigInt
  sellerPayoutAmountKobo    BigInt
  deliveryMethod            String         @default("PENDING_SELECTION") @db.VarChar(64)
  deliveryFeeKobo           BigInt         @default(0)
  status                    SubOrderStatus @default(PENDING)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  order                     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller                    User           @relation("SellerSubOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items                     OrderItem[]

  @@index([orderId, status])
  @@index([sellerId, createdAt])
}

model OrderItem {
  id                 String          @id @default(cuid())
  subOrderId         String
  productId          String?
  variantId          String?
  productName        String
  variantLabel       String?
  sku                String?
  quantity           Int
  unitPriceKobo      BigInt
  lineTotalKobo      BigInt
  productImagePath   String?
  inventoryAppliedAt DateTime?
  subOrder           SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Restrict)
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subOrderId])
  @@index([productId])
  @@index([variantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id @db.VarChar(64)
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailDelivery {
  id                String              @id @default(cuid())
  userId            String?
  recipient         String              @db.VarChar(320)
  template          String              @db.VarChar(64)
  provider          String              @db.VarChar(32)
  providerMessageId String?             @db.VarChar(191)
  status            EmailDeliveryStatus @default(QUEUED)
  subject           String              @db.VarChar(255)
  failureReason     String?             @db.Text
  createdAt         DateTime            @default(now())
  sentAt            DateTime?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, providerMessageId])
  @@index([userId, createdAt])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
}
