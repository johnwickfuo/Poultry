# Application
APP_NAME="Poultry Platform"
DATABASE_URL="mysql://poultry_user:change_me@127.0.0.1:3306/poultry_platform"
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Mail provider
MAIL_PROVIDER="resend"
MAIL_FROM="Poultry Platform <no-reply@example.com>"
RESEND_API_KEY=""

# Payments
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# AI and optional cache
GEMINI_API_KEY=""
REDIS_URL=""

# Local media storage (use a persistent absolute path in production)
STORAGE_ROOT=""

# Initial super-admin seed
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
